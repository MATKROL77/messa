# ══════════════════════════════════════════════════════════════
# MESSA — Variables de entorno
# Copiá este archivo a .env (local) o cargalas en tu hosting/Cloudflare
# (wrangler secret put NOMBRE_VARIABLE) — NUNCA subas el .env real a git.
# ══════════════════════════════════════════════════════════════

# ⚠ IMPORTANTE — LOS HASH DE BCRYPT LLEVAN "$"
# Next.js expande variables dentro de los archivos .env, así que un hash como
#     $2b$12$abc...
# se interpreta como las variables $2b y $12 y queda destruido: el login falla
# con "Email o contraseña incorrectos" aunque la contraseña sea correcta.
# Escapá cada "$" con una barra invertida:
#     CREATOR_PASSWORD_HASH=\$2b\$12\$abc...
# (Esto NO hace falta al cargarlo con `wrangler secret put`, sólo en .env.)

# ── Autenticación (obligatorio para poder loguearte al panel admin) ──
# Clave para firmar las sesiones. Generala con: openssl rand -hex 32
# También se usa para derivar los códigos QR de las mesas si no definís
# MESSA_CODIGO_SEED.
SESSION_SECRET=

# Cuenta del creador (control total, incluye tema y fidelidad)
CREATOR_EMAIL=matiascolimodio@gmail.com
CREATOR_NOMBRE=Matías Colimodio
# Generá el hash con: node scripts/generar-hash.js "TuContraseñaReal"
CREATOR_PASSWORD_HASH=

# Cuenta del dueño / admin del restaurante
ADMIN_EMAIL=admin@tu-restaurante.com
ADMIN_NOMBRE=Dueño del restaurante
ADMIN_PASSWORD_HASH=

# Cuenta de editor (carta y stock únicamente)
EDITOR_EMAIL=editor@tu-restaurante.com
EDITOR_NOMBRE=Encargado de salón
EDITOR_PASSWORD_HASH=

# Cuenta Staff: sólo operación diaria (salón, pedidos y reservas), sin acceso de dueño.
STAFF_EMAIL=staff@tu-restaurante.com
STAFF_NOMBRE=Personal de salón
STAFF_PASSWORD_HASH=

# ── Códigos de mesa (opcional) ──
# Clave con la que se derivan los códigos que viajan en el QR de cada mesa.
# Cambiarla invalida TODOS los QR impresos. Si no la definís se usa
# SESSION_SECRET. Generala con: openssl rand -hex 32
MESSA_CODIGO_SEED=

# ── Despliegue bajo un subdirectorio (opcional) ──
# Sólo para la vista previa estática de GitHub Pages, que sirve el sitio en
# https://usuario.github.io/messa. En un dominio propio dejalo vacío.
NEXT_PUBLIC_BASE_PATH=

# ── Mercado Pago (opcional — sin esto, la app usa un checkout de demo) ──
# Access Token real de tu cuenta de Mercado Pago (developers.mercadopago.com)
MP_ACCESS_TOKEN=
# Secreto de firma del webhook (te lo da MP al configurar la notificación)
MP_WEBHOOK_SECRET=

# ── Base de datos (opcional — sin esto, todo vive en localStorage) ──
# Ver LEEME.md → sección "Conectar Supabase" para instrucciones completas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
